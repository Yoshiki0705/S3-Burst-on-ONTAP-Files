        <mxCell id="notes-head" value="&lt;b&gt;補足&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1160.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;※1 同額のパターン:&lt;/b&gt; P4 は P2・P3 と同額。価格は作業セット比に連動しない" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1182.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;※2 仮置きの値:&lt;/b&gt; P1 の作業セット比と回数は出典のない仮置き" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1204.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;※3 S3 API 直読みの棒:&lt;/b&gt; 書き込みのない P1・P4 にだけ置く" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1226.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;※4 S3 Files のメタデータ課金:&lt;/b&gt; 4 KiB × 操作を紫に算入。1 MiB 以上で立つかは未確認" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1248.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn-head" value="&lt;b&gt;前提についての注意&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1280.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="この金額は固定の前提による試算です。主な前提は、capacity pool の割合（30%）、SSD 層の効率（40%）、&lt;br&gt;S3 Files の高性能ストレージのアクティブ割合（100%）、取り込みしきい値（128 KiB）、&lt;br&gt;デプロイ形態（Single-AZ 第一世代）です。前提を変えると金額と順序が大きく動きます。&lt;br&gt;64 KiB は FSx for ONTAP が安く、4 MiB は S3 Files が安いという向きも、この前提での結果で、&lt;br&gt;前提で入れ替わりえます。自分の環境の値に置き換えて選定してください。前提の一覧と感度は、&lt;br&gt;別の節・別の PR で整理する予定です。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1302.00" width="860.00" height="132.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="各棒は主要費目小計で、月額総額ではない。capacity pool の読み取りリクエスト数が未確認で、&lt;br&gt;S3 のバージョニング非現行版・バックアップ・通信費を算入していない。&lt;br&gt;リスト価格 × 数量の計算で、請求額ではありません。ap-northeast-1、単価は 2026-08-09 に取得し 2026-10-16 に&lt;br&gt;読み直しました。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1444.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
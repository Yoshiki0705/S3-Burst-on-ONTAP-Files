        <mxCell id="tick-bot-12500" value="$12,500" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="690.00" y="1334.00" width="80.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="notes-head" value="&lt;b&gt;Notes&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1368.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;*1 Same-cost patterns:&lt;/b&gt; P6 costs the same as P7. Price does not follow the working-set share.&lt;br&gt;P7 High-volume small-object writes: reads a 100% working set 2 times per object, with writes of 100% of&lt;br&gt;the stored volume. Working-set share, read count and write volume are repository assumptions." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1390.00" width="860.00" height="66.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;*2 Placeholder values:&lt;/b&gt; P5&amp;#x27;s write volume and P6&amp;#x27;s and P8&amp;#x27;s working-set share, read count and write volume&lt;br&gt;have no source." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1456.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;*3 Writes replace existing data:&lt;/b&gt; the stored volume stays at 20 TiB." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1500.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;*4 S3 Files metadata charge:&lt;/b&gt; same as Figure 1, *4." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1522.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn-head" value="&lt;b&gt;Read these figures with their assumptions&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1554.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="These amounts are an estimate under fixed assumptions: capacity pool share (30%), SSD-tier efficiency&lt;br&gt;(40%), S3 Files high-performance storage fully active (100%), import threshold (128 KiB), deployment&lt;br&gt;type (Single-AZ, 1st gen). Change them and both the amounts and the order can move a lot. Comparing&lt;br&gt;access through S3 Files with FSx for ONTAP, 64 KiB favors FSx for ONTAP and 4 MiB favors S3 Files;&lt;br&gt;that holds under these assumptions only and can reverse when they change. Replace them with your own&lt;br&gt;values when choosing. The full assumption list and sensitivity will follow in a separate section and PR." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1576.00" width="860.00" height="132.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Each bar is a major-line-item subtotal, not a monthly total. The capacity pool read-request count is&lt;br&gt;unconfirmed, and non-current S3 versions, backups and data transfer are excluded.&lt;br&gt;List price x quantity, not an invoice. ap-northeast-1; unit prices retrieved 2026-08-09 and re-read&lt;br&gt;2026-10-16." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1718.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

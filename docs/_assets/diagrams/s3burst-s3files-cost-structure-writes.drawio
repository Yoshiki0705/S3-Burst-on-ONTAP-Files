        <mxCell id="tick-bot-12500" value="$12,500" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="690.00" y="1290.00" width="80.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="notes-head" value="&lt;b&gt;補足&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1324.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;※1 同額のパターン:&lt;/b&gt; P6 は P7 と同額。価格は作業セット比に連動しない" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1346.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;※2 仮置きの値:&lt;/b&gt; P5 の書き込み量、P6・P8 の作業セット比、回数、書き込み量は出典のない仮置き" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1368.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;※3 書き込みは置き換え:&lt;/b&gt; 書き込みは既存データの置き換えで、保存量は 20 TiB のまま一定" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1390.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;※4 S3 API 直読みの棒:&lt;/b&gt; 書き込みを含むため該当なし（モデルの定義）" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1412.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="&lt;b&gt;※5 S3 Files のメタデータ課金:&lt;/b&gt; 図 1 の※4 と同じ" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1434.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn-head" value="&lt;b&gt;前提についての注意&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1466.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="この金額は固定の前提による試算です。主な前提は、capacity pool の割合（30%）、SSD 層の効率（40%）、&lt;br&gt;S3 Files の高性能ストレージのアクティブ割合（100%）、取り込みしきい値（128 KiB）、&lt;br&gt;デプロイ形態（Single-AZ 第一世代）です。前提を変えると金額と順序が大きく動きます。&lt;br&gt;64 KiB は FSx for ONTAP が安く、4 MiB は S3 Files が安いという向きも、この前提での結果で、&lt;br&gt;前提で入れ替わりえます。自分の環境の値に置き換えて選定してください。前提の一覧と感度は、&lt;br&gt;別の節・別の PR で整理する予定です。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1488.00" width="860.00" height="132.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="各棒は主要費目小計で、月額総額ではない。capacity pool の読み取りリクエスト数が未確認で、&lt;br&gt;S3 のバージョニング非現行版・バックアップ・通信費を算入していない。&lt;br&gt;リスト価格 × 数量の計算で、請求額ではありません。ap-northeast-1、単価は 2026-08-09 に取得し 2026-10-16 に&lt;br&gt;読み直しました。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1630.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
        <mxCell id="notes-head" value="&lt;b&gt;Notes&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1160.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;*1 Same-cost patterns:&lt;/b&gt; P4 costs the same as P2 and P3. Price does not follow the working-set share." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1182.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;*2 Placeholder values:&lt;/b&gt; P1&amp;#x27;s working-set share and read count have no source." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1204.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;*3 S3 API bars:&lt;/b&gt; placed only on P1 and P4, which have no writes." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1226.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;*4 S3 Files metadata charge:&lt;/b&gt; 4 KiB x operations is included in the purple segment. Whether it applies at&lt;br&gt;1 MiB and above is unconfirmed." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1248.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="warn-head" value="&lt;b&gt;Read these figures with their assumptions&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1302.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="These amounts are an estimate under fixed assumptions: capacity pool share (30%), SSD-tier efficiency&lt;br&gt;(40%), S3 Files high-performance storage fully active (100%), import threshold (128 KiB), deployment&lt;br&gt;type (Single-AZ, 1st gen). Change them and both the amounts and the order can move a lot. That 64 KiB&lt;br&gt;favors FSx for ONTAP and 4 MiB favors S3 Files holds under these assumptions only. Replace them with&lt;br&gt;your own values when choosing. The full assumption list and sensitivity will follow in a separate section&lt;br&gt;and PR." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1324.00" width="860.00" height="132.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Each bar is a major-line-item subtotal, not a monthly total. The capacity pool read-request count is&lt;br&gt;unconfirmed, and non-current S3 versions, backups and data transfer are excluded.&lt;br&gt;List price x quantity, not an invoice. ap-northeast-1; unit prices retrieved 2026-08-09 and re-read&lt;br&gt;2026-10-16." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="1466.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
      </root>

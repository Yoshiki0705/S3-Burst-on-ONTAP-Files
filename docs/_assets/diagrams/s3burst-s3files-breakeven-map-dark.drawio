        </mxCell>
        <mxCell id="name-4096-stored_tib" value="保存量（TiB）" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2089.00" width="250.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="key-4096-stored_tib" value="stored_tib（対数）" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2111.00" width="250.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="dom-4096-stored_tib" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=#FFFFFF;strokeWidth=2;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="262.00" y="2104.00" width="574.00" height="12.00" as="geometry" />
        </mxCell>
        <mxCell id="dot-4096-stored_tib" value="" style="ellipse;whiteSpace=nowrap;html=0;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="578.29" y="2103.00" width="14.00" height="14.00" as="geometry" />
        </mxCell>
        <mxCell id="val-4096-stored_tib-base" value="20" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="576.33" y="2078.00" width="17.92" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="lbl-4096-stored_tib-lo" value="0.125" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="262.00" y="2120.00" width="40.96" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="lbl-4096-stored_tib-hi" value="1,024" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=right;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="795.04" y="2120.00" width="40.96" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="lbl-4096-stored_tib-noflip" value="探索範囲では入れ替わらない" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="363.80" y="2120.00" width="370.40" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="ehead-4096" value="&lt;b&gt;値を列挙して試した前提（軸は引かない）&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2158.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="enum-4096-deployment" value="デプロイ形態 deployment（FSx for ONTAP 側。基準 SINGLE_AZ_1。出典の 3 値を試した）: 試した値では入れ替&lt;br&gt;わらない" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2184.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="enum-4096-throughput_mbps" value="スループットキャパシティ throughput_mbps（FSx for ONTAP 側。基準 自動選択（必要なスループットからモデル&lt;br&gt;が段を選ぶ）。出典の 4 値を試した）: 試した値では入れ替わらない" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2234.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="nottried-4096" value="この大きさでは次の前提を試していません。探索の対象に入っていないだけで、小計に効かないという意味ではありま&lt;br&gt;せん: active_fraction、s3files_threshold_kib、first_read_mode、first_read_stream_billing" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2284.00" width="860.00" height="66.00" as="geometry" />
        </mxCell>
        <mxCell id="reason-4096" value="active_fraction: 4 MiB は S3 Files の取り込みしきい値（128 KiB）を超え、小計の計算にアクティブ割合が入ら&lt;br&gt;ないため、探索していません" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2354.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="notes-head" value="&lt;b&gt;注&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2422.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1-0" value="&lt;b&gt;線の長さ:&lt;/b&gt; 線の長さは不確かさの大きさを表しません。線は、値に付いた根拠の種類と、モデルが探索した範囲を示し&lt;br&gt;ます。右端に「適用範囲の上限」と付いた軸（read_scale）は、モデルが成り立つ範囲の上限までを探索しており、&lt;br&gt;その先の向きは示していません。左端に小さな輪郭とゼロの目盛が付いた軸（metadata_multiplier）は、&lt;br&gt;値ゼロも試したことを示します。機械的な範囲の帯ではありません。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2444.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2-0" value="&lt;b&gt;P4 を例に選んだ理由:&lt;/b&gt; 書き込みがなく、仮置きと明記されていないパターンのうち、感度の対象にあるのは P4 だけで&lt;br&gt;す。基準の向きは 64 KiB と 4 MiB で逆です。P4 は保存 20,480 GiB のうち作業セットの 10% を、&lt;br&gt;各オブジェクト月あたり 10 回読む前提で、いずれも本リポジトリの試算前提です。入れ替わる前提の集合と値はパタ&lt;br&gt;ーンで異なります（例: 4 MiB の metadata_multiplier は、5 パターンで 779〜3.17e4）。&lt;br&gt;他のパターンは本文の表にあります。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2543.00" width="860.00" height="110.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-0" value="&lt;b&gt;基準の向きと件数:&lt;/b&gt; 基準の前提では、64 KiB は FSx for ONTAP の小計が低い、4 MiB は S3 Files の小計が低い。&lt;br&gt;この向きは前提によって入れ替わりえます。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2664.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-1" value="比べているのは 2 つの小計です。FSx for ONTAP の小計は読み取りをファイルシステムから行い、&lt;br&gt;S3 Access Points の読み取り課金は算入していません。S3 API 直読みは含みません。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2711.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-2" value="件数は「出典のある点を持つ前提の数 / 分母」です。分母は、この大きさで試し、P4 の小計を動かした前提の数で、&lt;br&gt;その側の前提の総数ではありません。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2758.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-3" value="64 KiB: FSx for ONTAP 4/6、S3 Files 0/4、両側 0/2。S3 Files 側は出典のある点を持つ前提の割合が低い。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2805.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-4" value="4 MiB: FSx for ONTAP 4/6、S3 Files 0/1、両側 0/2。S3 Files 側は出典のある点を持つ前提の割合が低い。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2830.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-5" value="64 KiB: 出典のある点を持つが、この大きさで P4 の小計を動かさないため数えていない前提:&lt;br&gt;first_read_stream_billing" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2855.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-6" value="試していない前提がある大きさ（4 MiB）では、パネルの末尾に挙げています。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2902.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-7" value="件数は出典のある点があるかどうかを数えたもので、前提の確からしさや値の不確かさを表しません。&lt;br&gt;提供形態や段のような選択も、出典のある点があれば数えます。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2927.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="各軸の値はモデルの計算で、実測ではありません。小計は主要費目小計で月額総額ではありません。ap-northeast-1、&lt;br&gt;単価は 2026-08-09 に取得しました。" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2988.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
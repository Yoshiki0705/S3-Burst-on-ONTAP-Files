        <mxCell id="lbl-4096-stored_tib-lo" value="0.125" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="262.00" y="2120.00" width="40.96" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="lbl-4096-stored_tib-hi" value="1,024" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=right;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="795.04" y="2120.00" width="40.96" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="lbl-4096-stored_tib-noflip" value="Does not change sides within the search range" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="363.80" y="2120.00" width="370.40" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="ehead-4096" value="&lt;b&gt;Assumptions tried at listed values (no axis)&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2158.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="enum-4096-deployment" value="Deployment type deployment (FSx for ONTAP side; baseline SINGLE_AZ_1; 3 sourced tried): does not&lt;br&gt;change sides at the values tried" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2184.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="enum-4096-throughput_mbps" value="Throughput capacity throughput_mbps (FSx for ONTAP side; baseline automatic (the model picks the tier&lt;br&gt;from the required throughput); 4 sourced tried): does not change sides at the values tried" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2234.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="nottried-4096" value="Not tried at this size. These assumptions are outside the search at this size; that does not mean they&lt;br&gt;have no effect on the subtotals: active_fraction, s3files_threshold_kib, first_read_mode,&lt;br&gt;first_read_stream_billing" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2284.00" width="860.00" height="66.00" as="geometry" />
        </mxCell>
        <mxCell id="reason-4096" value="active_fraction: 4 MiB is above the S3 Files import threshold (128 KiB), so the active share does not&lt;br&gt;enter the subtotal and was not searched" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2354.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="notes-head" value="&lt;b&gt;Notes&lt;/b&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2422.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-1-0" value="&lt;b&gt;Line length:&lt;/b&gt; Line length does not represent uncertainty. A line shows the kind of evidence behind a value&lt;br&gt;and the range the model searched. An axis whose right end reads &amp;#x27;upper limit of the applicable range&amp;#x27;&lt;br&gt;(read_scale) was searched up to the limit of the range where the model holds, and the figure shows&lt;br&gt;nothing beyond it." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2444.00" width="860.00" height="88.00" as="geometry" />
        </mxCell>
        <mxCell id="note-2-0" value="&lt;b&gt;Why P4 is the example:&lt;/b&gt; Among the patterns with no writes that are not labeled placeholders, P4 is the&lt;br&gt;only one in the sensitivity set. The baseline direction is opposite at 64 KiB and 4 MiB. P4 reads a 10%&lt;br&gt;working set of the 20,480 GiB stored, 10 times per object per month; both are repository assumptions. The&lt;br&gt;set of assumptions that flip the result, and their values, differ by pattern (for example&lt;br&gt;metadata_multiplier at 4 MiB: 779 to 3.17e4 across 5 patterns). The other patterns are in the tables in&lt;br&gt;the body." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2543.00" width="860.00" height="132.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-0" value="&lt;b&gt;Baseline direction and counts:&lt;/b&gt; Under the baseline assumptions, the FSx for ONTAP subtotal is lower at&lt;br&gt;64 KiB; the S3 Files subtotal is lower at 4 MiB. This direction can reverse when the assumptions change." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2686.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-1" value="The comparison is between two subtotals. The FSx for ONTAP subtotal reads from the file system and&lt;br&gt;includes no S3 Access Points read charge. Reading directly through the S3 API is not included." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2733.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-2" value="Each count reads &amp;#x27;assumptions with sourced points / denominator&amp;#x27;. The denominator is the number of&lt;br&gt;assumptions tried at this size that moved a P4 subtotal; it is not the total number of assumptions on that&lt;br&gt;side." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2780.00" width="860.00" height="66.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-3" value="64 KiB: FSx for ONTAP side 4/6, S3 Files side 0/4, both 0/2. The S3 Files side has a lower share of&lt;br&gt;assumptions with sourced points." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2849.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-4" value="4 MiB: FSx for ONTAP side 4/6, S3 Files side 0/1, both 0/2. The S3 Files side has a lower share of&lt;br&gt;assumptions with sourced points." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2896.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-5" value="64 KiB: assumptions with sourced points that are not counted because they do not move a P4 subtotal at&lt;br&gt;this size: first_read_stream_billing" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2943.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-6" value="Sizes with assumptions not tried (4 MiB) list them at the end of the panel." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="2990.00" width="860.00" height="22.00" as="geometry" />
        </mxCell>
        <mxCell id="note-3-7" value="The counts record whether sourced points exist. They do not express how reliable an assumption or its&lt;br&gt;value is. Choices such as the deployment type or a tier count when they have sourced points." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="3015.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Axis values are model calculations, not measurements. Subtotals are major-line-item subtotals, not&lt;br&gt;monthly totals. ap-northeast-1; unit prices retrieved 2026-08-09." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=16;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="0.00" y="3076.00" width="860.00" height="44.00" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
# Copy to samconfig.toml and edit. samconfig.toml is gitignored: it accumulates a real stack name,
# a real Region and an S3 bucket for artefacts, none of which belong in a public repository.
version = 0.1

[default.deploy.parameters]
stack_name = "s3-burst-__PATTERN_SLUG__"
region = "ap-northeast-1"
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true

# Fill from params.json. Keeping both files means the same values are written twice; the example
# params file is the one the README tells a reader to copy, so treat it as the source and paste here.
# parameter_overrides = "PatternName=__PATTERN_SLUG__ Environment=dev ..."

[default.build.parameters]
cached = true
parallel = true
